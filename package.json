{
  "name": "naptw-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx wrangler@latest pages dev --port 8080 --proxy 3000 --compatibility-date=2023-12-09 -- yarn dev:web",
    "dev:web": "vite",
    "build:pack": "tsc && vite build && cp -r functions dist/",
    "deploy": "yarn build:pack && npx wrangler@latest pages deploy dist",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.1.0",
    "axios": "^1.6.1",
    "flowbite": "^2.1.1",
    "flowbite-react": "^0.6.4",
    "punycode": "^2.3.1",
    "qrcode.react": "^3.1.0",
    "react": "^18.2.0",
    "react-country-flag": "^3.1.0",
    "react-dom": "^18.2.0",
    "react-ga4": "^2.1.0",
    "react-icons": "^4.11.0",
    "react-router-dom": "^7.0.1",
    "wrangler": "^3.15.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20231025.0",
    "@types/node": "^22.10.1",
    "@types/punycode": "^2.1.4",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "typescript": "^5.0.2",
    "vite": "^6.0.1",
    "vite-plugin-svgr": "^4.1.0"
  }
}
